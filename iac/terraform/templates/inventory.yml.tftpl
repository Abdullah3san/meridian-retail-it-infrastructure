all:
  vars:
    ansible_user: ansible
    ad_domain: ${domain}
  hosts:
%{ for name, vm in vms ~}
    ${name}:
      ansible_host: 10.10.20.${vm.octet}
%{ if vm.stack != null ~}
      compose_stack: ${vm.stack}
%{ endif ~}
%{ if vm.data_disk != null ~}
      data_disk_device: /dev/sdb
%{ endif ~}
%{ endfor ~}
  children:
%{ for group in groups ~}
    ${group}:
      hosts:
%{ for name, vm in vms ~}
%{ if contains(vm.groups, group) ~}
        ${name}:
%{ endif ~}
%{ endfor ~}
%{ endfor ~}
    critical:
      hosts:
%{ for name, vm in vms ~}
%{ if vm.critical ~}
        ${name}:
%{ endif ~}
%{ endfor ~}
