# Never commit real secrets if you adapt these sample configs for a real deployment
.env
*.env
*_rsa
*_ed25519
*.pem
*.key

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Terraform — state and real variable values stay local
.terraform/
*.tfstate
*.tfstate.*
terraform.tfvars
crash.log

# Ansible — the real (encrypted) vault and any vault password file
iac/ansible/inventory/group_vars/all/vault.yml
.vault_pass*
*.retry
